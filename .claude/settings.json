{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run test:*)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run baseline)",
      "Bash(npm run report)",
      "Bash(npx playwright test:*)",
      "Bash(npx playwright install:*)",
      "Bash(npx playwright show-report:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "WebFetch(domain:joinhuub.com)",
      "WebFetch(domain:www.joinhuub.com)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push:*)"
    ]
  }
}
